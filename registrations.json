            // =============================================================
            // 8. SAVE / UPDATE / DELETE REGISTRATION
            // =============================================================
            window.submitRegistration = async function() {
                if (!validateWizardStep(1) || !validateWizardStep(2) || !validateWizardStep(3)) return;

                const submitBtn = document.getElementById('wizard-submit-btn');
                const submitText = document.getElementById('wizard-submit-text');
                const prevLabel = submitText ? submitText.textContent : 'ยืนยันและบันทึกข้อมูล';
                if (submitBtn) submitBtn.disabled = true;
                if (submitText) submitText.textContent = 'กำลังบันทึกข้อมูล...';

                try {
                    const editingId = (document.getElementById('editing-doc-id')?.value || '').trim();
                    const checkedActivities = Array.from(document.querySelectorAll('input[name="activities"]:checked')).map(cb => cb.value);

                    const recordData = {
                        fullNameTh: (document.getElementById('fullNameTh')?.value || '').trim(),
                        nickname: (document.getElementById('nickname')?.value || '').trim(),
                        fullNameEn: (document.getElementById('fullNameEn')?.value || '').trim().toUpperCase(),
                        gender: document.getElementById('gender')?.value || 'ชาย',
                        phone: (document.getElementById('phone')?.value || '').trim(),
                        contactId: (document.getElementById('contactId')?.value || '').trim(),
                        emergencyContact: (document.getElementById('emergencyContact')?.value || '').trim() || '-',
                        roomCapacity: Number(document.getElementById('roomCapacity')?.value || 3),
                        roommateRequest: (document.getElementById('roommateRequest')?.value || '').trim(),
                        dietary: document.getElementById('dietary')?.value || 'ทานอาหารได้ปกติ',
                        shuttlePackage: 'roundtrip',
                        heuTransitOption: document.getElementById('heuTransitOption')?.value || 'metro_harbin',
                        luggage: document.getElementById('luggage')?.value || 'กระเป๋า 20-24 นิ้ว (1 ใบ) + เป้สะพายหลัง',
                        arrivalNote: (document.getElementById('arrivalNote')?.value || '').trim() || 'พร้อมกลุ่มหลักที่สถานี Metro 哈尔滨工程大学站',
                        activities: checkedActivities,
                        coldReadiness: document.getElementById('coldReadiness')?.value || 'เตรียมครบแล้ว (เสื้อขนเป็ด, ลองจอน, รองเท้าลุยหิมะ)',
                        notes: (document.getElementById('notes')?.value || '').trim() || '-',
                        updatedAtMs: Date.now()
                    };

                    let savedToGitHub = false;
                    if (GITHUB_DB_CONFIG.enabled && activeGitHubTarget.token) {
                        try {
                            await mutateGitHubRecords((latestRecords) => {
                                if (editingId) {
                                    const idx = latestRecords.findIndex(r => r.id === editingId);
                                    if (idx >= 0) {
                                        latestRecords[idx] = { ...latestRecords[idx], ...recordData, id: editingId };
                                    } else {
                                        latestRecords.push({ ...recordData, id: editingId, createdAtMs: Date.now() });
                                    }
                                } else {
                                    const newId = 'reg_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
                                    latestRecords.push({ ...recordData, id: newId, createdAtMs: Date.now() });
                                }
                                return latestRecords;
                            }, editingId ? `Update registration: ${recordData.nickname}` : `Add registration: ${recordData.nickname}`);
                            savedToGitHub = true;
                        } catch (ghErr) {
                            console.warn('GitHub sync fallback to local cache:', ghErr);
                            githubStatusReason = ghErr.message || 'บันทึกออนไลน์ไม่สำเร็จ';
                            updateDbStatusBadge('local', 'บันทึกในเครื่อง (Local)');
                        }
                    }

                    if (!savedToGitHub) {
                        if (editingId) {
                            const idx = registrations.findIndex(r => r.id === editingId);
                            if (idx >= 0) {
                                registrations[idx] = { ...registrations[idx], ...recordData, id: editingId };
                            }
                        } else {
                            const newId = 'reg_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
                            registrations.push({ ...recordData, id: newId, createdAtMs: Date.now() });
                        }
                        saveLocalCache(registrations);
                        syncAllViews();
                    }

                    resetWizard(true);
                    navigateTo('results');
                    showToast(
                        savedToGitHub
                            ? (editingId ? 'อัปเดตข้อมูลลงไฟล์ GitHub เรียบร้อยแล้ว!' : 'ลงทะเบียนและบันทึกลงไฟล์ GitHub เรียบร้อยแล้ว!')
                            : 'บันทึกข้อมูลเรียบร้อยแล้ว! (สำรองไว้ในเครื่อง)',
                        false
                    );
                } catch (err) {
                    console.error(err);
                    showToast(`เกิดข้อผิดพลาด: ${err.message || 'ไม่สามารถบันทึกได้'}`, true);
                } finally {
                    if (submitBtn) submitBtn.disabled = false;
                    if (submitText) submitText.textContent = prevLabel;
                }
            };

            window.editRegistration = function(docId) {
                if (!isAdminLoggedIn) {
                    openAdminLoginModal(() => editRegistration(docId));
                    return;
                }
                const item = registrations.find(r => r.id === docId);
                if (!item) return;

                document.getElementById('editing-doc-id').value = item.id;
                document.getElementById('wizard-cancel-edit-btn')?.classList.remove('hidden');
                const headerTitle = document.getElementById('wizard-header-title');
                const submitText = document.getElementById('wizard-submit-text');
                if (headerTitle) headerTitle.textContent = `แก้ไขข้อมูล: ${item.nickname}`;
                if (submitText) submitText.textContent = 'บันทึกการแก้ไขข้อมูล';

                document.getElementById('fullNameTh').value = item.fullNameTh || '';
                document.getElementById('nickname').value = item.nickname || '';
                document.getElementById('fullNameEn').value = item.fullNameEn || '';
                selectGender(item.gender || 'ชาย');
                document.getElementById('phone').value = item.phone || '';
                document.getElementById('contactId').value = item.contactId || '';
                document.getElementById('emergencyContact').value = item.emergencyContact === '-' ? '' : (item.emergencyContact || '');
                selectRoomCapacity(item.roomCapacity || 3);
                document.getElementById('roommateRequest').value = item.roommateRequest || '';
                document.getElementById('dietary').value = item.dietary || 'ทานอาหารได้ปกติ';
                document.getElementById('heuTransitOption').value = item.heuTransitOption || 'metro_harbin';
                document.getElementById('luggage').value = item.luggage || 'กระเป๋า 20-24 นิ้ว (1 ใบ) + เป้สะพายหลัง';
                document.getElementById('arrivalNote').value = item.arrivalNote || '';
                document.getElementById('coldReadiness').value = item.coldReadiness || 'เตรียมครบแล้ว (เสื้อขนเป็ด, ลองจอน, รองเท้าลุยหิมะ)';
                document.getElementById('notes').value = item.notes === '-' ? '' : (item.notes || '');

                const actSet = new Set(Array.isArray(item.activities) ? item.activities : []);
                document.querySelectorAll('input[name="activities"]').forEach(cb => {
                    cb.checked = actSet.has(cb.value);
                });

                navigateTo('register');
                goToWizardStep(1);
            };

            window.requestDelete = function(docId, name) {
                if (!isAdminLoggedIn) {
                    openAdminLoginModal(() => requestDelete(docId, name));
                    return;
                }
                pendingDeleteId = docId;
                const txt = document.getElementById('confirm-delete-text');
                if (txt) txt.textContent = `คุณต้องการลบรายชื่อ "${name}" ออกจากฐานข้อมูลใช่หรือไม่?`;
                const modal = document.getElementById('confirm-delete-modal');
                if (modal) {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                    renderIcons();
                }
            };

            window.closeDeleteModal = function() {
                pendingDeleteId = null;
                const modal = document.getElementById('confirm-delete-modal');
                if (modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            };

            async function executeDeleteRecord() {
                if (!pendingDeleteId || !isAdminLoggedIn) return;
                const targetId = pendingDeleteId;
                closeDeleteModal();

                try {
                    let deletedOnline = false;
                    if (GITHUB_DB_CONFIG.enabled && activeGitHubTarget.token) {
                        try {
                            await mutateGitHubRecords(
                                (latest) => latest.filter(r => r.id !== targetId),
                                `Delete registration: ${targetId}`
                            );
                            deletedOnline = true;
                        } catch (e) {
                            console.warn('GitHub delete fallback:', e);
                        }
                    }
                    if (!deletedOnline) {
                        registrations = registrations.filter(r => r.id !== targetId);
                        saveLocalCache(registrations);
                        syncAllViews();
                    }
                    showToast('ลบรายชื่อออกจากฐานข้อมูลเรียบร้อยแล้ว', false);
                } catch (err) {
                    showToast(`เกิดข้อผิดพลาดในการลบ: ${err.message}`, true);
                }
            }

            // =============================================================
            // 9. SMART ROOM MATCHING & INDIVIDUAL BILLING ENGINE
            // =============================================================
            function computeRoomMatchingAndCosts() {
                const totalPax = registrations.length;
                const actualVanShare = totalPax > 0
                    ? PRICING.shuttleRoundTripNet / totalPax
                    : PRICING.shuttleRoundTripNet / 10;

                const rooms = [];
                const personBillingMap = {};
                const assignedIds = new Set();

                // Sort by creation order
                const ordered = [...registrations].sort((a, b) => (a.createdAtMs || 0) - (b.createdAtMs || 0));

                // 1) Private 1-person rooms
                ordered.filter(p => Number(p.roomCapacity || 3) === 1).forEach(p => {
                    assignedIds.add(p.id);
                    rooms.push({
                        roomNumber: rooms.length + 1,
                        capacity: 1,
                        members: [p]
                    });
                });

                // 2) Shared rooms (capacity 2 or 3)
                [3, 2].forEach(cap => {
                    const pool = ordered.filter(p => !assignedIds.has(p.id) && Number(p.roomCapacity || 3) === cap);

                    // First pass: group people who explicitly requested each other's nickname
                    for (const person of pool) {
                        if (assignedIds.has(person.id)) continue;

                        const group = [person];
                        assignedIds.add(person.id);
                        const reqText = (person.roommateRequest || '').toLowerCase();

                        if (reqText) {
                            for (const candidate of pool) {
                                if (group.length >= cap) break;
                                if (assignedIds.has(candidate.id)) continue;
                                const candNick = (candidate.nickname || '').trim().toLowerCase();
                                const candFull = (candidate.fullNameTh || '').trim().toLowerCase();
                                if ((candNick && reqText.includes(candNick)) || (candFull && reqText.includes(candFull))) {
                                    group.push(candidate);
                                    assignedIds.add(candidate.id);
                                }
                            }
                        }

                        // Check if anyone else in the pool requested this person
                        if (group.length < cap) {
                            const myNick = (person.nickname || '').trim().toLowerCase();
                            for (const candidate of pool) {
                                if (group.length >= cap) break;
                                if (assignedIds.has(candidate.id)) continue;
                                const candReq = (candidate.roommateRequest || '').toLowerCase();
                                if (myNick && candReq.includes(myNick)) {
                                    group.push(candidate);
                                    assignedIds.add(candidate.id);
                                }
                            }
                        }

                        // Fill remaining slots with unassigned people of same room capacity
                        for (const candidate of pool) {
                            if (group.length >= cap) break;
                            if (assignedIds.has(candidate.id)) continue;
                            group.push(candidate);
                            assignedIds.add(candidate.id);
                        }

                        rooms.push({
                            roomNumber: rooms.length + 1,
                            capacity: cap,
                            members: group
                        });
                    }
                });

                // Compute individual bills
                let groupGrandTotal = 0;
                rooms.forEach(room => {
                    const memberCount = Math.max(room.members.length, 1);
                    const currentActualRoomShare = PRICING.roomTotal2Nights / memberCount;
                    const fullTargetRoomShare = PRICING.roomTotal2Nights / room.capacity;

                    room.members.forEach(m => {
                        const heuInfo = PRICING.heuTransitOptions[m.heuTransitOption] || PRICING.heuTransitOptions.metro_harbin;
                        const currentActualTotal = heuInfo.thb + actualVanShare + currentActualRoomShare;
                        const targetFullRoomTotal = heuInfo.thb + actualVanShare + fullTargetRoomShare;
                        groupGrandTotal += currentActualTotal;

                        personBillingMap[m.id] = {
                            roomNumber: room.roomNumber,
                            roomCapacity: room.capacity,
                            roomMemberCount: memberCount,
                            isRoomFull: memberCount >= room.capacity,
                            heuLabel: heuInfo.label,
                            heuCost: heuInfo.thb,
                            vanShare: actualVanShare,
                            currentActualRoomShare,
                            fullTargetRoomShare,
                            currentActualTotal,
                            targetFullRoomTotal
                        };
                    });
                });

                return {
                    rooms,
                    personBillingMap,
                    actualVanShare,
                    groupGrandTotal
                };
            }

            // =============================================================
            // 10. VIEW RENDERERS (KPIs, DBD CALCULATOR, RESULTS)
            // =============================================================
            function syncAllViews() {
                const count = registrations.length;
                document.querySelectorAll('.live-pax-count').forEach(el => {
                    el.textContent = String(count);
                });

                const seatsBadge = document.getElementById('hub-seats-badge');
                const progressBar = document.getElementById('hub-progress-bar');
                const remaining = Math.max(0, PRICING.maxVanSeats - count);
                if (seatsBadge) {
                    seatsBadge.textContent = remaining > 0 ? `ว่าง ${remaining} ที่นั่ง` : 'เต็ม 15 ที่นั่งแล้ว';
                }
                if (progressBar) {
                    progressBar.style.width = `${Math.min(100, (count / PRICING.maxVanSeats) * 100)}%`;
                }

                if (activeView === 'results') renderResultsViews();
                if (activeView === 'budget') renderDbdSection();
            }

            // DBD Calculator Renderers
            window.setDbdRoomCap = function(cap) {
                dbdRoomCap = Number(cap) || 3;
                [3, 2, 1].forEach(c => {
                    const btn = document.getElementById(`dbd-cap-btn-${c}`);
                    if (!btn) return;
                    if (c === dbdRoomCap) {
                        btn.className = 'py-2.5 px-3 rounded-xl bg-blue-600 text-white text-xs sm:text-sm font-bold shadow-sm transition';
                    } else {
                        btn.className = 'py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs sm:text-sm font-semibold transition';
                    }
                });
                renderDbdSection();
            };

            window.selectDbdPax = function(val) {
                dbdSelectedPax = Math.max(1, Math.min(15, Number(val) || 10));
                const slider = document.getElementById('dbd-pax-slider');
                if (slider) slider.value = String(dbdSelectedPax);
                renderDbdSection();
            };

            window.stepDbdPax = function(delta) {
                selectDbdPax(dbdSelectedPax + delta);
            };

            window.scrollDbdCarousel = function(dir) {
                const track = document.getElementById('dbd-carousel-track');
                if (!track) return;
                track.scrollBy({ left: dir * 240, behavior: 'smooth' });
            };

            function renderDbdSection() {
                const n = dbdSelectedPax;
                const heuCost = PRICING.heuTransitOptions.metro_harbin.thb;
                const vanShare = PRICING.shuttleRoundTripNet / n;
                const vanFull15 = PRICING.shuttleRoundTripNet / 15;
                const hotelShare = PRICING.roomTotal2Nights / dbdRoomCap;
                const totalPerPerson = heuCost + vanShare + hotelShare;
                const diffFromFull15 = vanShare - vanFull15;

                const matchBadge = document.getElementById('dbd-match-badge');
                const displayEl = document.getElementById('dbd-selected-pax-display');
                const subEl = document.getElementById('dbd-room-summary-sub');
                const spotTotal = document.getElementById('dbd-spot-total');
                const spotDiff = document.getElementById('dbd-spot-diff');
                const spotHeu = document.getElementById('dbd-spot-heu');
                const spotVan = document.getElementById('dbd-spot-van');
                const spotHotel = document.getElementById('dbd-spot-hotel');
                const spotCapLabel = document.getElementById('dbd-spot-cap-label');

                if (matchBadge) matchBadge.textContent = `${n} ท่าน`;
                if (displayEl) displayEl.textContent = String(n);
                if (subEl) subEl.textContent = n < 15 ? `เหลือที่นั่งว่างในรถ ${15 - n} ที่` : 'เต็มคันรถตู้ 15 ที่นั่งพอดี!';
                if (spotTotal) spotTotal.textContent = `฿ ${fmtThb(totalPerPerson)}`;
                if (spotDiff) {
                    spotDiff.textContent = n < 15
                        ? `ต่างจากเรทเต็มคัน 15 คน +฿ ${fmtThb(diffFromFull15)} / ท่าน`
                        : 'ราคาประหยัดสูงสุด (หารครบ 15 ที่นั่งเต็มคัน)';
                }
                if (spotHeu) spotHeu.textContent = `฿ ${fmtThb(heuCost)}`;
                if (spotVan) spotVan.textContent = `฿ ${fmtThb(vanShare)}`;
                if (spotHotel) spotHotel.textContent = `฿ ${fmtThb(hotelShare)}`;
                if (spotCapLabel) spotCapLabel.textContent = `${dbdRoomCap} คน/ห้อง`;
                document.querySelectorAll('.dbd-n-label').forEach(el => { el.textContent = String(n); });

                const track = document.getElementById('dbd-carousel-track');
                if (track) {
                    let cardsHtml = '';
                    for (let i = 1; i <= 15; i++) {
                        const vShare = PRICING.shuttleRoundTripNet / i;
                        const tot = heuCost + vShare + hotelShare;
                        const isSelected = i === n;
                        cardsHtml += `
                            <button type="button" onclick="selectDbdPax(${i})" class="snap-start shrink-0 w-44 text-left p-4 rounded-2xl border-2 transition ${isSelected ? 'border-blue-600 bg-blue-50 shadow-md' : 'border-slate-200 bg-white hover:border-blue-300'}">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-extrabold ${isSelected ? 'text-blue-700' : 'text-slate-900'}">${i} คน</span>
                                    <span class="text-[10px] px-2 py-0.5 rounded-full ${i === 15 ? 'bg-emerald-100 text-emerald-700 font-bold' : 'bg-slate-100 text-slate-600'}">รถ ฿${Math.round(vShare)}</span>
                                </div>
                                <p class="text-lg font-extrabold text-slate-900 mt-2">฿ ${fmtThb(tot)}</p>
                                <p class="text-[10px] text-slate-500 mt-0.5">รวม HEU + รถ + ที่พัก</p>
                            </button>
                        `;
                    }
                    track.innerHTML = cardsHtml;
                }
            }

            // Results Sub-Tab Switcher
            window.switchResultsSubTab = function(tabName) {
                resultsSubTab = tabName;
                const roomsBtn = document.getElementById('results-tab-rooms');
                const listBtn = document.getElementById('results-tab-list');
                const roomsPane = document.getElementById('results-pane-rooms');
                const listPane = document.getElementById('results-pane-list');

                if (tabName === 'rooms') {
                    if (roomsBtn) roomsBtn.className = 'py-2.5 px-3 rounded-xl bg-white text-slate-900 font-bold text-xs sm:text-sm shadow-sm transition flex items-center justify-center gap-1.5';
                    if (listBtn) listBtn.className = 'py-2.5 px-3 rounded-xl text-slate-600 hover:text-slate-900 font-semibold text-xs sm:text-sm transition flex items-center justify-center gap-1.5';
                    roomsPane?.classList.remove('hidden');
                    listPane?.classList.add('hidden');
                } else {
                    if (listBtn) listBtn.className = 'py-2.5 px-3 rounded-xl bg-white text-slate-900 font-bold text-xs sm:text-sm shadow-sm transition flex items-center justify-center gap-1.5';
                    if (roomsBtn) roomsBtn.className = 'py-2.5 px-3 rounded-xl text-slate-600 hover:text-slate-900 font-semibold text-xs sm:text-sm transition flex items-center justify-center gap-1.5';
                    listPane?.classList.remove('hidden');
                    roomsPane?.classList.add('hidden');
                }
            };

            window.renderResultsViews = function() {
                const { rooms, personBillingMap, actualVanShare, groupGrandTotal } = computeRoomMatchingAndCosts();
                const total = registrations.length;

                // KPI Updates
                const maleCount = registrations.filter(r => r.gender === 'ชาย').length;
                const femaleCount = registrations.filter(r => r.gender === 'หญิง').length;
                const cap1Count = registrations.filter(r => Number(r.roomCapacity) === 1).length;
                const cap2Count = registrations.filter(r => Number(r.roomCapacity) === 2).length;
                const cap3Count = registrations.filter(r => Number(r.roomCapacity || 3) === 3).length;

                const statTotal = document.getElementById('stat-total');
                const statGender = document.getElementById('stat-gender-split');
                const statRooms = document.getElementById('stat-rooms-matched');
                const statPref = document.getElementById('stat-room-pref-split');
                const statVan = document.getElementById('stat-van-share');
                const statVanNote = document.getElementById('stat-van-note');
                const statGrand = document.getElementById('stat-group-grand-total');

                if (statTotal) statTotal.textContent = String(total);
                if (statGender) statGender.textContent = `ชาย ${maleCount} • หญิง ${femaleCount}`;
                if (statRooms) statRooms.textContent = String(rooms.length);
                if (statPref) statPref.textContent = `1คน:${cap1Count} | 2คน:${cap2Count} | 3คน:${cap3Count}`;
                if (statVan) statVan.textContent = `฿ ${fmtThb(actualVanShare)}`;
                if (statVanNote) {
                    statVanNote.textContent = total > 0
                        ? `หารจริง ${total} คน (จากเหมา ฿9,367.26)`
                        : 'อ้างอิง 10 คน (ยังไม่มีผู้ลงทะเบียน)';
                }
                if (statGrand) statGrand.textContent = `฿ ${fmtThb(groupGrandTotal)}`;

                // Sub-Tab A: Room Matching Cards
                const roomContainer = document.getElementById('room-matching-container');
                if (roomContainer) {
                    if (rooms.length === 0) {
                        roomContainer.innerHTML = `
                            <div class="md:col-span-2 bg-white rounded-3xl p-8 border border-slate-200 text-center space-y-3">
                                <p class="text-base font-bold text-slate-800">ยังไม่มีรายชื่อผู้ลงทะเบียนในระบบ</p>
                                <p class="text-xs text-slate-500">เมื่อมีผู้ลงทะเบียนเข้ามา ระบบจะจัดกลุ่มห้องพัก (1/2/3 คน) และคำนวณยอดจ่ายรายบุคคลให้อัตโนมัติทันที</p>
                                <button type="button" onclick="navigateTo('register')" class="px-5 py-2.5 rounded-xl bg-blue-600 text-white text-xs font-bold">ไปหน้าลงทะเบียนคนแรก →</button>
                            </div>
                        `;
                    } else {
                        roomContainer.innerHTML = rooms.map(room => {
                            const isFull = room.members.length >= room.capacity;
                            const missingCount = Math.max(0, room.capacity - room.members.length);
                            const badgeHtml = isFull
                                ? `<span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-bold">ครบ ${room.capacity}/${room.capacity} คน</span>`
                                : `<span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[11px] font-bold">รอเพื่อนเพิ่มอีก ${missingCount} คน (${room.members.length}/${room.capacity})</span>`;

                            const membersHtml = room.members.map(m => {
                                const bill = personBillingMap[m.id];
                                const adminMiniBtns = isAdminLoggedIn
                                    ? `<div class="flex items-center gap-1 mt-1.5 justify-end">
                                         <button type="button" onclick="editRegistration('${m.id}')" class="px-2 py-0.5 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 text-[10px] font-bold">แก้ไข</button>
                                         <button type="button" onclick="requestDelete('${m.id}', '${escapeHtml(m.fullNameTh)}')" class="px-2 py-0.5 rounded-lg bg-rose-100 hover:bg-rose-200 text-rose-700 text-[10px] font-bold">ลบ</button>
                                       </div>`
                                    : '';
                                return `
                                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-between gap-2">
                                        <div>
                                            <p class="font-bold text-sm text-slate-900">${escapeHtml(m.nickname)} <span class="text-xs font-normal text-slate-500">(${escapeHtml(m.fullNameTh)})</span></p>
                                            <p class="text-[11px] text-slate-500">${escapeHtml(bill.heuLabel)} • ที่พัก ฿${fmtThb(bill.currentActualRoomShare)}</p>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <p class="text-sm font-extrabold text-blue-700">฿ ${fmtThb(bill.currentActualTotal)}</p>
                                            <p class="text-[10px] text-slate-400">ยอดรวมสุทธิ/คน</p>
                                            ${adminMiniBtns}
                                        </div>
                                    </div>
                                `;
                            }).join('');

                            return `
                                <div class="bg-white rounded-3xl p-5 border border-slate-200 shadow-sm space-y-3">
                                    <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3">
                                        <div>
                                            <span class="text-xs font-bold text-blue-600">ห้องที่ ${room.roomNumber}</span>
                                            <h3 class="text-base font-bold text-slate-900">แพ็กเกจนอน ${room.capacity} คน / ห้อง</h3>
                                        </div>
                                        ${badgeHtml}
                                    </div>
                                    <div class="space-y-2">${membersHtml}</div>
                                    ${!isFull ? `<p class="text-[11px] text-amber-700 bg-amber-50 px-3 py-2 rounded-xl">หากมีเพื่อนเลือกนอน ${room.capacity} คน/ห้อง เพิ่มอีก ${missingCount} คน ค่าที่พักจะลดเหลือ ฿${fmtThb(PRICING.roomTotal2Nights / room.capacity)}/คน</p>` : ''}
                                </div>
                            `;
                        }).join('');
                    }
                }

                // Sub-Tab B: All Participants List
                const listContainer = document.getElementById('participant-cards-container');
                if (listContainer) {
                    const q = (document.getElementById('search-input')?.value || '').trim().toLowerCase();
                    const filterCap = document.getElementById('filter-select')?.value || 'all';

                    const filtered = registrations.filter(item => {
                        const capStr = String(item.roomCapacity || 3);
                        if (filterCap !== 'all' && capStr !== filterCap) return false;
                        if (!q) return true;
                        const bill = personBillingMap[item.id];
                        const hay = `${item.fullNameTh} ${item.nickname} ${item.fullNameEn} ${item.roommateRequest} ห้องที่ ${bill ? bill.roomNumber : ''}`.toLowerCase();
                        return hay.includes(q);
                    });

                    if (filtered.length === 0) {
                        listContainer.innerHTML = `
                            <div class="bg-white rounded-3xl p-8 border border-slate-200 text-center text-xs text-slate-500">
                                ไม่พบรายชื่อผู้ลงทะเบียนที่ตรงกับเงื่อนไขการค้นหา
                            </div>
                        `;
                    } else {
                        listContainer.innerHTML = filtered.map((item, idx) => {
                            const bill = personBillingMap[item.id];
                            return `
                                <div class="bg-white rounded-3xl p-4 sm:p-5 border border-slate-200 shadow-sm space-y-3">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-700 font-extrabold text-sm flex items-center justify-center shrink-0">
                                                #${idx + 1}
                                            </div>
                                            <div>
                                                <div class="flex flex-wrap items-center gap-1.5">
                                                    <h4 class="font-bold text-base text-slate-900">${escapeHtml(item.nickname)} — ${escapeHtml(item.fullNameTh)}</h4>
                                                    <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 text-[11px] font-semibold">${escapeHtml(item.gender)}</span>
                                                    ${bill ? `<span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[11px] font-bold">ห้องที่ ${bill.roomNumber} (${bill.roomCapacity} คน/ห้อง)</span>` : ''}
                                                </div>
                                                <p class="text-xs text-slate-500 mt-0.5">${escapeHtml(item.fullNameEn)}</p>
                                            </div>
                                        </div>
                                        <div class="sm:text-right">
                                            <p class="text-lg font-extrabold text-blue-700">฿ ${bill ? fmtThb(bill.currentActualTotal) : '0.00'}</p>
                                            <p class="text-[11px] text-slate-400">ประมาณการรวมสุทธิ</p>
                                        </div>
                                    </div>

                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 pt-2 border-t border-slate-100 text-[11px] text-slate-600">
                                        <div><span class="text-slate-400">ติดต่อ:</span> ${escapeHtml(item.phone)} (${escapeHtml(item.contactId)})</div>
                                        <div><span class="text-slate-400">เดินทาง/กระเป๋า:</span> ${escapeHtml(bill ? bill.heuLabel : '')} • ${escapeHtml(item.luggage)}</div>
                                        <div><span class="text-slate-400">อาหาร:</span> ${escapeHtml(item.dietary)}</div>
                                    </div>

                                    ${isAdminLoggedIn ? `
                                    <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                                        <button type="button" onclick="editRegistration('${item.id}')" class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs font-bold transition">
                                            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                            <span>แก้ไขข้อมูล</span>
                                        </button>
                                        <button type="button" onclick="requestDelete('${item.id}', '${escapeHtml(item.fullNameTh)}')" class="inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-bold transition">
                                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                            <span>ลบรายชื่อ</span>
                                        </button>
                                    </div>
                                    ` : ''}
                                </div>
                            `;
                        }).join('');
                    }
                }
                renderIcons();

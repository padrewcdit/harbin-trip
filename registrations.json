            // =============================================================
            // 5. GITHUB JSON DATABASE SYNC ENGINE (with Local Cache Fallback)
            // =============================================================
            function utf8ToBase64(str) {
                const bytes = new TextEncoder().encode(str);
                let binary = '';
                for (let i = 0; i < bytes.length; i++) {
                    binary += String.fromCharCode(bytes[i]);
                }
                return btoa(binary);
            }

            function base64ToUtf8(b64) {
                const clean = (b64 || '').replace(/\s/g, '');
                const binary = atob(clean);
                const bytes = new Uint8Array(binary.length);
                for (let i = 0; i < binary.length; i++) {
                    bytes[i] = binary.charCodeAt(i);
                }
                return new TextDecoder().decode(bytes);
            }

            function updateDbStatusBadge(mode, labelText) {
                const badge = document.getElementById('db-status-badge');
                if (!badge) return;
                if (mode === 'github') {
                    badge.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-emerald-500/20 text-emerald-200 border border-emerald-400/30 hover:opacity-90 transition cursor-pointer';
                    badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span><span>${escapeHtml(labelText || 'GitHub DB')}</span>`;
                } else if (mode === 'local') {
                    badge.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-sky-500/20 text-sky-200 border border-sky-400/30 hover:opacity-90 transition cursor-pointer';
                    badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-sky-400"></span><span>${escapeHtml(labelText || 'พร้อมใช้งาน')}</span>`;
                } else {
                    badge.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-amber-500/20 text-amber-200 border border-amber-400/30 hover:opacity-90 transition cursor-pointer';
                    badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span><span>${escapeHtml(labelText || 'กำลังซิงก์...')}</span>`;
                }
            }

            async function fetchGitHubRecords(silent = true) {
                const { owner, repo, branch, filePath, token } = activeGitHubTarget;
                if (!owner || !repo || !filePath) {
                    throw new Error('ยังไม่ได้ระบุ Owner/Repo');
                }

                const apiUrl = `https://api.github.com/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${filePath}?ref=${encodeURIComponent(branch || 'main')}&_t=${Date.now()}`;
                const headers = { 'Accept': 'application/vnd.github+json' };
                if (token) headers['Authorization'] = `Bearer ${token}`;

                const res = await fetch(apiUrl, { headers, cache: 'no-store' });

                if (res.status === 404) {
                    githubFileSha = null;
                    useGitHubDb = Boolean(token);
                    githubStatusReason = token
                        ? 'พร้อมสร้างไฟล์ registrations.json อัตโนมัติเมื่อบันทึกข้อมูลแรก'
                        : 'ไม่พบไฟล์ registrations.json และยังไม่ได้ใส่ Token';
                    if (!silent) showToast('พร้อมสร้างไฟล์ registrations.json เมื่อบันทึกครั้งแรก', false);
                    return registrations;
                }

                if (res.status === 401 || res.status === 403) {
                    githubStatusReason = 'GitHub Token หมดอายุหรือถูกยกเลิกสิทธิ์ (กรุณาอัปเดต Token ใหม่ในตั้งค่า GitHub DB)';
                    throw new Error(githubStatusReason);
                }

                if (!res.ok) {
                    throw new Error(`GitHub API ตอบกลับสถานะ ${res.status}`);
                }

                const payload = await res.json();
                githubFileSha = payload.sha || null;
                const decoded = base64ToUtf8(payload.content || '');
                const parsed = decoded.trim() ? JSON.parse(decoded) : [];
                registrations = Array.isArray(parsed) ? parsed : [];
                registrations.sort((a, b) => (a.createdAtMs || 0) - (b.createdAtMs || 0));
                saveLocalCache(registrations);

                useGitHubDb = Boolean(token);
                githubStatusReason = token
                    ? `เชื่อมต่อไฟล์ ${owner}/${repo}/${filePath} เรียบร้อยแล้ว`
                    : `อ่านข้อมูลจาก ${owner}/${repo}/${filePath} สำเร็จ (โหมดอ่านอย่างเดียว)`;

                updateDbStatusBadge(useGitHubDb ? 'github' : 'local', useGitHubDb ? 'GitHub DB' : 'อ่านจาก GitHub');
                syncAllViews();
                return registrations;
            }

            async function mutateGitHubRecords(mutatorFn, commitMessage) {
                const { owner, repo, branch, filePath, token } = activeGitHubTarget;
                if (!token) {
                    throw new Error('ไม่มี GitHub Token สำหรับเขียนไฟล์');
                }

                const apiUrl = `https://api.github.com/repos/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}/contents/${filePath}`;
                const headers = {
                    'Accept': 'application/vnd.github+json',
                    'Authorization': `Bearer ${token}`,
                    'Content-Type': 'application/json'
                };

                for (let attempt = 0; attempt < 3; attempt++) {
                    let latestRecords = [...registrations];
                    let currentSha = null;

                    const getRes = await fetch(`${apiUrl}?ref=${encodeURIComponent(branch || 'main')}&_t=${Date.now()}`, {
                        headers: { 'Accept': 'application/vnd.github+json', 'Authorization': `Bearer ${token}` },
                        cache: 'no-store'
                    });

                    if (getRes.status === 200) {
                        const fileData = await getRes.json();
                        currentSha = fileData.sha;
                        const text = base64ToUtf8(fileData.content || '');
                        const parsed = text.trim() ? JSON.parse(text) : [];
                        latestRecords = Array.isArray(parsed) ? parsed : [];
                    } else if (getRes.status === 404) {
                        currentSha = null;
                        latestRecords = [...registrations];
                    } else if (getRes.status === 401 || getRes.status === 403) {
                        githubStatusReason = 'GitHub Token หมดอายุหรือถูกยกเลิกสิทธิ์';
                        throw new Error(githubStatusReason);
                    } else {
                        throw new Error(`อ่านไฟล์จาก GitHub ไม่สำเร็จ (${getRes.status})`);
                    }

                    const updatedRecords = await mutatorFn(latestRecords);
                    const jsonPretty = JSON.stringify(updatedRecords, null, 2);

                    const putBody = {
                        message: commitMessage || 'Update snowtown registrations',
                        content: utf8ToBase64(jsonPretty),
                        branch: branch || 'main'
                    };
                    if (currentSha) putBody.sha = currentSha;

                    const putRes = await fetch(apiUrl, {
                        method: 'PUT',
                        headers,
                        body: JSON.stringify(putBody)
                    });

                    if (putRes.ok) {
                        const putResult = await putRes.json();
                        githubFileSha = putResult.content?.sha || null;
                        registrations = updatedRecords;
                        registrations.sort((a, b) => (a.createdAtMs || 0) - (b.createdAtMs || 0));
                        saveLocalCache(registrations);
                        useGitHubDb = true;
                        updateDbStatusBadge('github', 'GitHub DB');
                        syncAllViews();
                        return updatedRecords;
                    }

                    if (putRes.status === 409 && attempt < 2) {
                        continue; // Retry on SHA conflict
                    }

                    const errJson = await putRes.json().catch(() => ({}));
                    throw new Error(errJson.message || `บันทึกไฟล์ลง GitHub ไม่สำเร็จ (${putRes.status})`);
                }
            }

            async function initCentralDatabase() {
                // Load local cache immediately so UI is responsive right away
                registrations = loadLocalCache();
                syncAllViews();

                if (GITHUB_DB_CONFIG.enabled && activeGitHubTarget.owner && activeGitHubTarget.repo) {
                    updateDbStatusBadge('syncing', 'ซิงก์ GitHub...');
                    try {
                        await fetchGitHubRecords(true);
                        if (useGitHubDb) {
                            updateDbStatusBadge('github', 'GitHub DB');
                        }
                        // Poll every 25 seconds when viewing results
                        setInterval(() => {
                            if (activeView === 'results' && !document.hidden) {
                                fetchGitHubRecords(true).catch(() => {});
                            }
                        }, 25000);
                        return;
                    } catch (err) {
                        useGitHubDb = false;
                        githubStatusReason = err.message || 'ไม่สามารถเชื่อมต่อ GitHub API ได้';
                        updateDbStatusBadge('local', 'พร้อมใช้งาน (Local)');
                    }
                } else {
                    updateDbStatusBadge('local', 'พร้อมใช้งาน');
                }
            }

            // =============================================================
            // 6. NAVIGATION & INTERACTIVE SELECTORS
            // =============================================================
            window.navigateTo = function(viewName) {
                activeView = viewName;
                const views = ['hub', 'overview', 'register', 'budget', 'results'];
                views.forEach(v => {
                    const el = document.getElementById(`view-${v}`);
                    if (!el) return;
                    if (v === viewName) el.classList.remove('hidden');
                    else el.classList.add('hidden');
                });

                document.querySelectorAll('.top-nav-btn').forEach(btn => {
                    const isTarget = btn.getAttribute('data-nav') === viewName;
                    btn.className = isTarget
                        ? 'top-nav-btn px-3 py-2 rounded-xl bg-white text-slate-900 font-bold shadow-sm transition'
                        : 'top-nav-btn px-3 py-2 rounded-xl text-sky-100 hover:bg-white/10 transition';
                });

                document.querySelectorAll('.bottom-nav-btn').forEach(btn => {
                    const isTarget = btn.getAttribute('data-nav') === viewName;
                    if (isTarget) {
                        btn.classList.remove('text-slate-500');
                        btn.classList.add('text-blue-600');
                    } else {
                        btn.classList.remove('text-blue-600');
                        btn.classList.add('text-slate-500');
                    }
                });

                const backHubBtn = document.getElementById('top-back-hub-btn');
                if (backHubBtn) {
                    if (viewName === 'hub') backHubBtn.classList.add('hidden');
                    else backHubBtn.classList.remove('hidden');
                }

                if (viewName === 'results') renderResultsViews();
                if (viewName === 'budget') renderDbdSection();

                renderIcons();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            window.selectGender = function(val) {
                const input = document.getElementById('gender');
                if (input) input.value = val;
                document.querySelectorAll('.gender-btn').forEach(btn => {
                    const isMatch = btn.getAttribute('data-gender') === val;
                    btn.className = isMatch
                        ? 'gender-btn py-3.5 rounded-2xl border-2 border-blue-600 bg-blue-50 text-blue-700 font-bold text-sm transition'
                        : 'gender-btn py-3.5 rounded-2xl border-2 border-slate-200 bg-white text-slate-700 font-semibold text-sm transition';
                });
            };

            window.selectRoomCapacity = function(cap) {
                const numCap = Number(cap) || 3;
                const input = document.getElementById('roomCapacity');
                if (input) input.value = numCap;

                document.querySelectorAll('.room-cap-btn').forEach(btn => {
                    const btnCap = Number(btn.getAttribute('data-cap'));
                    if (btnCap === numCap) {
                        btn.className = 'room-cap-btn w-full text-left p-4 sm:p-5 rounded-2xl border-2 border-blue-600 bg-blue-50/70 transition flex items-center justify-between gap-3';
                    } else {
                        btn.className = 'room-cap-btn w-full text-left p-4 sm:p-5 rounded-2xl border-2 border-slate-200 bg-white hover:border-blue-300 transition flex items-center justify-between gap-3';
                    }
                });

                const wrapper = document.getElementById('roommate-input-wrapper');
                const hint = document.getElementById('step5-room-hint');
                if (numCap === 1) {
                    if (wrapper) wrapper.classList.add('hidden');
                    if (hint) hint.textContent = 'คุณเลือกพักเดี่ยวส่วนตัว 1 ห้อง ไม่ต้องจับคู่เพื่อนร่วมห้อง';
                } else {
                    if (wrapper) wrapper.classList.remove('hidden');
                    if (hint) hint.textContent = `ระบุชื่อเล่นเพื่อนที่ต้องการนอนห้องเดียวกัน (แบบนอน ${numCap} คน/ห้อง) เพื่อให้ระบบแมตช์ชิ่งให้อัตโนมัติ`;
                }
            };

            // =============================================================
            // 7. STEP-BY-STEP WIZARD LOGIC (STEPS 1..8)
            // =============================================================
            window.goToWizardStep = function(stepNum) {
                const target = Math.max(1, Math.min(TOTAL_WIZARD_STEPS, Number(stepNum) || 1));
                currentWizardStep = target;

                for (let i = 1; i <= TOTAL_WIZARD_STEPS; i++) {
                    const stepEl = document.getElementById(`wizard-step-${i}`);
                    if (!stepEl) continue;
                    if (i === target) stepEl.classList.remove('hidden');
                    else stepEl.classList.add('hidden');
                }

                const badge = document.getElementById('wizard-step-badge');
                const progress = document.getElementById('wizard-progress-bar');
                const prevBtn = document.getElementById('wizard-prev-btn');
                const nextBtn = document.getElementById('wizard-next-btn');
                const submitBtn = document.getElementById('wizard-submit-btn');

                if (badge) {
                    badge.textContent = target === TOTAL_WIZARD_STEPS
                        ? 'ขั้นตอนที่ 8 จาก 8 • ตรวจสอบสรุปค่าใช้จ่าย'
                        : `ขั้นตอนที่ ${target} จาก ${TOTAL_WIZARD_STEPS}`;
                }
                if (progress) {
                    progress.style.width = `${(target / TOTAL_WIZARD_STEPS) * 100}%`;
                }

                if (prevBtn) {
                    if (target === 1) prevBtn.classList.add('opacity-50', 'pointer-events-none');
                    else prevBtn.classList.remove('opacity-50', 'pointer-events-none');
                }

                if (target === TOTAL_WIZARD_STEPS) {
                    if (nextBtn) nextBtn.classList.add('hidden');
                    if (submitBtn) submitBtn.classList.remove('hidden');
                    renderReviewSummary();
                } else {
                    if (nextBtn) nextBtn.classList.remove('hidden');
                    if (submitBtn) submitBtn.classList.add('hidden');
                }

                renderIcons();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            };

            function validateWizardStep(stepNum) {
                if (stepNum === 1) {
                    const th = (document.getElementById('fullNameTh')?.value || '').trim();
                    const nick = (document.getElementById('nickname')?.value || '').trim();
                    if (!th) {
                        showToast('กรุณากรอกชื่อ-นามสกุล (ภาษาไทย) ก่อนครับ', true);
                        document.getElementById('fullNameTh')?.focus();
                        return false;
                    }
                    if (!nick) {
                        showToast('กรุณากรอกชื่อเล่นก่อนครับ', true);
                        document.getElementById('nickname')?.focus();
                        return false;
                    }
                }
                if (stepNum === 2) {
                    const en = (document.getElementById('fullNameEn')?.value || '').trim();
                    if (!en) {
                        showToast('กรุณากรอกชื่อภาษาอังกฤษตามพาสปอร์ตก่อนครับ', true);
                        document.getElementById('fullNameEn')?.focus();
                        return false;
                    }
                }
                if (stepNum === 3) {
                    const phone = (document.getElementById('phone')?.value || '').trim();
                    const contact = (document.getElementById('contactId')?.value || '').trim();
                    if (!phone) {
                        showToast('กรุณากรอกเบอร์โทรศัพท์ติดต่อก่อนครับ', true);
                        document.getElementById('phone')?.focus();
                        return false;
                    }
                    if (!contact) {
                        showToast('กรุณากรอก LINE ID หรือ WeChat ID ก่อนครับ', true);
                        document.getElementById('contactId')?.focus();
                        return false;
                    }
                }
                return true;
            }

            window.nextWizardStep = function() {
                if (!validateWizardStep(currentWizardStep)) return;
                if (currentWizardStep < TOTAL_WIZARD_STEPS) {
                    goToWizardStep(currentWizardStep + 1);
                }
            };

            window.prevWizardStep = function() {
                if (currentWizardStep > 1) {
                    goToWizardStep(currentWizardStep - 1);
                }
            };

            window.resetWizard = function(clearFields = true) {
                const editIdEl = document.getElementById('editing-doc-id');
                const cancelBtn = document.getElementById('wizard-cancel-edit-btn');
                const headerTitle = document.getElementById('wizard-header-title');
                const submitText = document.getElementById('wizard-submit-text');

                if (editIdEl) editIdEl.value = '';
                if (cancelBtn) cancelBtn.classList.add('hidden');
                if (headerTitle) headerTitle.textContent = 'ลงทะเบียนผู้เดินทาง';
                if (submitText) submitText.textContent = 'ยืนยันและบันทึกข้อมูล';

                if (clearFields) {
                    ['fullNameTh', 'nickname', 'fullNameEn', 'phone', 'contactId', 'emergencyContact', 'roommateRequest', 'arrivalNote', 'notes'].forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.value = '';
                    });
                    selectGender('ชาย');
                    selectRoomCapacity(3);
                    const dietaryEl = document.getElementById('dietary');
                    if (dietaryEl) dietaryEl.selectedIndex = 0;
                    const heuEl = document.getElementById('heuTransitOption');
                    if (heuEl) heuEl.value = 'metro_harbin';
                    const lugEl = document.getElementById('luggage');
                    if (lugEl) lugEl.selectedIndex = 0;
                    const coldEl = document.getElementById('coldReadiness');
                    if (coldEl) coldEl.selectedIndex = 0;
                }
                goToWizardStep(1);
            };

            function renderReviewSummary() {
                const fullNameTh = (document.getElementById('fullNameTh')?.value || '').trim();
                const nickname = (document.getElementById('nickname')?.value || '').trim();
                const fullNameEn = (document.getElementById('fullNameEn')?.value || '').trim().toUpperCase();
                const gender = document.getElementById('gender')?.value || 'ชาย';
                const phone = (document.getElementById('phone')?.value || '').trim();
                const contactId = (document.getElementById('contactId')?.value || '').trim();
                const roomCap = Number(document.getElementById('roomCapacity')?.value || 3);
                const roommateReq = (document.getElementById('roommateRequest')?.value || '').trim();
                const dietary = document.getElementById('dietary')?.value || 'ทานอาหารได้ปกติ';
                const heuKey = document.getElementById('heuTransitOption')?.value || 'metro_harbin';
                const luggage = document.getElementById('luggage')?.value || '';

                const heuInfo = PRICING.heuTransitOptions[heuKey] || PRICING.heuTransitOptions.metro_harbin;
                const isEditing = Boolean(document.getElementById('editing-doc-id')?.value);
                const projectedPax = Math.max(registrations.length + (isEditing ? 0 : 1), 10);
                const vanCost = PRICING.shuttleRoundTripNet / projectedPax;
                const hotelCost = PRICING.roomTotal2Nights / roomCap;
                const grandTotal = heuInfo.thb + vanCost + hotelCost;

                const typeLabel = document.getElementById('review-room-type-label');
                const grandEl = document.getElementById('review-grand-total');
                const heuEl = document.getElementById('review-cost-heu');
                const vanEl = document.getElementById('review-cost-van');
                const vanNoteEl = document.getElementById('review-van-note');
                const capTextEl = document.getElementById('review-room-cap-text');
                const roomNoteEl = document.getElementById('review-room-note');
                const hotelEl = document.getElementById('review-cost-hotel');
                const gridEl = document.getElementById('review-details-grid');

                if (typeLabel) typeLabel.textContent = `ห้องพักแบบ นอน ${roomCap} คน / ห้อง`;
                if (grandEl) grandEl.textContent = `฿ ${fmtThb(grandTotal)}`;
                if (heuEl) heuEl.textContent = `฿ ${fmtThb(heuInfo.thb)}`;
                if (vanEl) vanEl.textContent = `฿ ${fmtThb(vanCost)}`;
                if (vanNoteEl) vanNoteEl.textContent = `อ้างอิงหาร ${projectedPax} ท่าน (หากครบ 15 คนเหลือ ฿624.48)`;
                if (capTextEl) capTextEl.textContent = `${roomCap} คน/ห้อง`;
                if (roomNoteEl) {
                    roomNoteEl.textContent = roomCap === 1
                        ? 'พักเดี่ยวส่วนตัว 1 ห้องเต็ม (2 คืน + อาหารเช้า)'
                        : `หารค่าห้อง ฿6,673.60 ร่วมกัน ${roomCap} ท่าน (2 คืน + อาหารเช้า)`;
                }
                if (hotelEl) hotelEl.textContent = `฿ ${fmtThb(hotelCost)}`;

                if (gridEl) {
                    const roomMatchText = roomCap === 1
                        ? 'นอน 1 คน/ห้อง (พักเดี่ยวส่วนตัว)'
                        : `นอน ${roomCap} คน/ห้อง (${roommateReq ? 'จับคู่: ' + roommateReq : 'ให้ระบบจับคู่อัตโนมัติ'})`;

                    gridEl.innerHTML = `
                        <div class="bg-white p-2.5 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] text-slate-400 block">ชื่อ-นามสกุล (ไทย / เล่น)</span>
                            <strong class="text-slate-900">${escapeHtml(fullNameTh)} (${escapeHtml(nickname)})</strong>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] text-slate-400 block">ชื่อพาสปอร์ต & เพศ</span>
                            <strong class="text-slate-900">${escapeHtml(fullNameEn)} (${escapeHtml(gender)})</strong>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] text-slate-400 block">เบอร์โทร & LINE/WeChat</span>
                            <strong class="text-slate-900">${escapeHtml(phone)} • ${escapeHtml(contactId)}</strong>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] text-slate-400 block">ห้องพัก & เพื่อนร่วมห้อง</span>
                            <strong class="text-blue-700">${escapeHtml(roomMatchText)}</strong>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] text-slate-400 block">เดินทางจาก HEU & สัมภาระ</span>
                            <strong class="text-slate-900">${escapeHtml(heuInfo.label)} • ${escapeHtml(luggage)}</strong>
                        </div>
                        <div class="bg-white p-2.5 rounded-xl border border-slate-200/80">
                            <span class="text-[11px] text-slate-400 block">อาหารเช้า</span>
                            <strong class="text-slate-900">${escapeHtml(dietary)}</strong>
                        </div>

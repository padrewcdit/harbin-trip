            window.applySessionGitHubToken = async function() {
                const owner = (document.getElementById('gh-input-owner')?.value || '').trim();
                const repo = (document.getElementById('gh-input-repo')?.value || '').trim();
                const branch = (document.getElementById('gh-input-branch')?.value || 'main').trim();
                const filePath = (document.getElementById('gh-input-filepath')?.value || 'registrations.json').trim();
                const token = (document.getElementById('gh-input-token')?.value || '').trim();

                if (!owner || !repo || !token) {
                    showToast('กรุณากรอก Owner, Repository และ Token ให้ครบครับ', true);
                    return;
                }

                activeGitHubTarget = { owner, repo, branch, filePath, token };
                try { localStorage.setItem('harbin_trip_gh_token', token); } catch (e) {}

                try {
                    await fetchGitHubRecords(false);
                    openDbSetupModal();
                    showToast('เชื่อมต่อและซิงก์ข้อมูลจาก GitHub สำเร็จ!', false);
                } catch (err) {
                    useGitHubDb = false;
                    openDbSetupModal();
                    showToast(`เชื่อมต่อไม่สำเร็จ: ${err.message}`, true);
                }
            };

            window.copyGitHubConfigSnippet = function() {
                const snippet = `const GITHUB_DB_CONFIG = {\n    enabled: true,\n    owner: '${activeGitHubTarget.owner}',\n    repo: '${activeGitHubTarget.repo}',\n    branch: '${activeGitHubTarget.branch}',\n    filePath: '${activeGitHubTarget.filePath}',\n    token: '${activeGitHubTarget.token}'\n};`;
                copyTextFallback(snippet, 'คัดลอกโค้ดตั้งค่า GitHub DB เรียบร้อยแล้ว!');
            };

            function copyTextFallback(text, successMsg) {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try {
                    document.execCommand('copy');
                    showToast(successMsg, false);
                } catch (e) {
                    showToast('ไม่สามารถคัดลอกอัตโนมัติได้', true);
                }
                document.body.removeChild(ta);
            }

            window.copyGroupSummary = function() {
                const { rooms, personBillingMap, actualVanShare } = computeRoomMatchingAndCosts();
                const lines = [
                    `❄️ สรุปรายชื่อทริปหมู่บ้านหิมะจีน – ยาบูลี (18–20 ธ.ค. 2569)`,
                    `👥 ผู้ลงทะเบียนทั้งหมด: ${registrations.length} / 15 ท่าน (เปิด ${rooms.length} ห้อง)`,
                    `🚐 ค่ารถตู้เหมา 15 ที่นั่ง (ไป-กลับ): ฿${fmtThb(actualVanShare)} / คน`,
                    `--------------------------------`
                ];

                rooms.forEach(r => {
                    const names = r.members.map(m => `${m.nickname} (฿${fmtThb(personBillingMap[m.id]?.currentActualTotal || 0)})`).join(', ');
                    lines.push(`🏠 ห้องที่ ${r.roomNumber} [นอน ${r.capacity} คน]: ${names}`);
                });

                copyTextFallback(lines.join('\n'), 'คัดลอกสรุปรายชื่อและยอดจ่ายส่งเข้า LINE เรียบร้อยแล้ว!');
            };

            window.exportCSV = function() {
                if (registrations.length === 0) {
                    showToast('ยังไม่มีข้อมูลสำหรับส่งออก CSV', true);
                    return;
                }
                const { personBillingMap } = computeRoomMatchingAndCosts();
                const headers = ['ลำดับ', 'ชื่อเล่น', 'ชื่อ-นามสกุล (ไทย)', 'ชื่อพาสปอร์ต (อังกฤษ)', 'เพศ', 'เบอร์โทร', 'LINE/WeChat', 'ประเภทห้อง(คน)', 'ห้องที่จับคู่ได้', 'เพื่อนที่ขอจับคู่', 'อาหาร', 'เดินทาง HEU', 'กระเป๋า', 'ยอดประมาณการรวม(บาท)'];
                const rows = registrations.map((r, i) => {
                    const b = personBillingMap[r.id];
                    return [
                        i + 1,
                        r.nickname,
                        r.fullNameTh,
                        r.fullNameEn,
                        r.gender,
                        r.phone,
                        r.contactId,
                        r.roomCapacity || 3,
                        b ? `ห้องที่ ${b.roomNumber}` : '-',
                        r.roommateRequest || '-',
                        r.dietary,
                        b ? b.heuLabel : '-',
                        r.luggage,
                        b ? b.currentActualTotal.toFixed(2) : '0.00'
                    ].map(v => `"${String(v ?? '').replace(/"/g, '""')}"`).join(',');
                });

                const csvContent = '\uFEFF' + [headers.join(','), ...rows].join('\n');
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `xuexiang-trip-2569-${new Date().toISOString().slice(0, 10)}.csv`;
                a.click();
                URL.revokeObjectURL(url);
                showToast('ดาวน์โหลดไฟล์ CSV เรียบร้อยแล้ว', false);
            };

            window.exportBackupJSON = function() {
                const jsonStr = JSON.stringify(registrations, null, 2);
                const blob = new Blob([jsonStr], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `registrations-backup-${new Date().toISOString().slice(0, 10)}.json`;
                a.click();
                URL.revokeObjectURL(url);
                showToast('สำรองข้อมูลไฟล์ JSON เรียบร้อยแล้ว', false);
            };

            window.importBackupJSON = async function(event) {
                const file = event?.target?.files?.[0];
                if (!file) return;
                try {
                    const text = await file.text();
                    const parsed = JSON.parse(text);
                    if (!Array.isArray(parsed)) throw new Error('รูปแบบไฟล์ JSON ไม่ถูกต้อง');

                    let added = 0;
                    const merged = [...registrations];
                    for (const rec of parsed) {
                        if (!rec || !rec.fullNameTh) continue;
                        const exists = merged.some(e => e.fullNameTh === rec.fullNameTh && e.phone === rec.phone);
                        if (!exists) {
                            merged.push({
                                ...rec,
                                id: rec.id || ('reg_' + Date.now() + '_' + added),
                                createdAtMs: rec.createdAtMs || (Date.now() + added),
                                updatedAtMs: Date.now()
                            });
                            added++;
                        }
                    }

                    if (GITHUB_DB_CONFIG.enabled && activeGitHubTarget.token) {
                        try {
                            await mutateGitHubRecords(() => merged, `Restore backup (${added} records)`);
                        } catch (e) {
                            registrations = merged;
                            saveLocalCache(registrations);
                            syncAllViews();
                        }
                    } else {
                        registrations = merged;
                        saveLocalCache(registrations);
                        syncAllViews();
                    }

                    showToast(`กู้คืนและรวมข้อมูลเพิ่ม ${added} รายการเรียบร้อยแล้ว`, false);
                } catch (err) {
                    showToast(`กู้คืนข้อมูลไม่สำเร็จ: ${err.message}`, true);
                } finally {
                    event.target.value = '';
                }
            };

            // =============================================================
            // 13. BOOTSTRAP APPLICATION ON LOAD
            // =============================================================
            document.getElementById('confirm-delete-action-btn')?.addEventListener('click', executeDeleteRecord);

            initSnowEffect();
            updateAdminUIState();
            initCentralDatabase();
            navigateTo('hub');
            goToWizardStep(1);
        })();
    </script>
</body>
</html>

            window.submitAdminLogin = function(e) {
                if (e) e.preventDefault();
                const userVal = (document.getElementById('admin-username-input')?.value || '').trim();
                const passVal = (document.getElementById('admin-password-input')?.value || '').trim();
                const errBox = document.getElementById('admin-login-error');

                if (userVal === ADMIN_CREDENTIALS.username && passVal === ADMIN_CREDENTIALS.password) {
                    isAdminLoggedIn = true;
                    try { sessionStorage.setItem('xuexiang_admin_auth', 'true'); } catch (err) {}
                    closeAdminLoginModal();
                    updateAdminUIState();
                    renderResultsViews();
                    showToast('เข้าสู่ระบบแอดมินสำเร็จ! ปลดล็อกเมนูแก้ไขและลบข้อมูลแล้ว', false);

                    if (pendingAdminCallback) {
                        const cb = pendingAdminCallback;
                        pendingAdminCallback = null;
                        cb();
                    }
                } else {
                    if (errBox) errBox.classList.remove('hidden');
                    showToast('รหัสแอดมินหรือรหัสผ่านไม่ถูกต้อง', true);
                }
            };

            window.logoutAdmin = function() {
                isAdminLoggedIn = false;
